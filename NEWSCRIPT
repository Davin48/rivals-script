local function getUltraTarget()
    local closest = nil
    local shortest = math.huge
    local camPos = camera.CFrame.Position
    local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= localPlayer and player.Character then
            local part = player.Character:FindFirstChild(UltraMagicBullet.TargetPart)
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if part and humanoid and humanoid.Health > 0 then
                local pos, visible = worldToScreen(part.Position)
                local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                local worldDist = (part.Position - camPos).Magnitude
                
                -- Wallbang allows targeting through walls
                if (visible or UltraMagicBullet.Wallbang) and dist < 800 then
                    if worldDist < shortest then
                        shortest = worldDist
                        closest = part
                    end
                end
            end
        end
    end
    return closest
end

-- Find Fire Remote via GC Scanning
local function findFireRemote()
    local foundRemotes = {}
    local RS = game:GetService("ReplicatedStorage")
    
    -- Method 1: Deep scan ALL remotes in ReplicatedStorage
    for _, obj in pairs(RS:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("UnreliableRemoteEvent") then
            local name = obj.Name:lower()
            local path = obj:GetFullName()
            
            -- Skip non-shooting remotes
            local isWrong = name:find("enter") or name:find("leave") or name:find("ui") or 
                          name:find("lobby") or name:find("shop") or name:find("menu") or
                          name:find("spawn") or name:find("teleport") or name:find("range") or
                          name:find("unlock") or name:find("levelup") or name:find("favorite") or
                          name:find("switch") or name:find("pick") or name:find("setuse") or
                          name:find("charm") or name:find("skin") or name:find("camo")
            
            if not isWrong then
                -- Look for shooting-related names
                if name:find("fire") or name:find("shoot") or name:find("bullet") or 
                   name:find("hit") or name:find("damage") or name:find("weapon") or
                   name:find("gun") or name:find("projectile") or name:find("ammo") or
                   name:find("ray") or name:find("cast") or name:find("trace") then
                    table.insert(foundRemotes, obj)
                end
            end
        end
    end
    
    -- Method 2: Check PlayerScripts/Client modules
    for _, module in pairs(getgc(true)) do
        if typeof(module) == "table" then
            for k, v in pairs(module) do
                if typeof(v) == "Instance" and (v:IsA("RemoteEvent") or v:IsA("UnreliableRemoteEvent")) then
                    local name = v.Name:lower()
                    if name:find("fire") or name:find("shoot") then
                        table.insert(foundRemotes, v)
                    end
                end
            end
        end
    end
    
    -- Remove duplicates
    local uniqueRemotes = {}
    local seen = {}
    for _, remote in pairs(foundRemotes) do
        if not seen[remote] then
            seen[remote] = true
            table.insert(uniqueRemotes, remote)
        end
    end
    
    -- Show found remotes
    notify("Magic Bullet", "Schuss-Remotes gefunden: " .. tostring(#uniqueRemotes), 2)
    for i, remote in pairs(uniqueRemotes) do
        if i <= 5 then
            notify("Magic Bullet", i .. ": " .. remote.Name, 1)
        end
    end
    
    return uniqueRemotes
end

