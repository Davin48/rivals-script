local ESPObjects = {}

local function RemoveESP(player)
    if ESPObjects[player] then
        for _, obj in pairs(ESPObjects[player]) do
            if type(obj) == "table" and #obj > 0 then
                -- Handle arrays (skeleton lines)
                for _, line in ipairs(obj) do
                    pcall(function() line:Remove() end)
                end
            else
                -- Handle single objects
                pcall(function() obj:Remove() end)
            end
        end
        ESPObjects[player] = nil
    end
end

local function CreateESP(player)
    RemoveESP(player)
    ESPObjects[player] = {}

    -- Box (BLACK)
    local box = Drawing.new("Square")
    box.Visible = false
    box.Color = Color3.fromRGB(0, 0, 0)
    box.Thickness = 1.5
    box.Filled = false
    ESPObjects[player].box = box

    -- Name
    local nameTag = Drawing.new("Text")
    nameTag.Visible = false
    nameTag.Color = Color3.fromRGB(255, 255, 255)
    nameTag.Size = 13
    nameTag.Center = true
    nameTag.Outline = true
    nameTag.Font = Drawing.Fonts.UI
    ESPObjects[player].nameTag = nameTag

    -- Distance
    local distTag = Drawing.new("Text")
    distTag.Visible = false
    distTag.Color = Color3.fromRGB(200, 200, 200)
    distTag.Size = 11
    distTag.Center = true
    distTag.Outline = true
    distTag.Font = Drawing.Fonts.UI
    ESPObjects[player].distTag = distTag

    -- Tracer
    local tracer = Drawing.new("Line")
    tracer.Visible = false
    tracer.Color = Color3.fromRGB(255, 60, 60)
    tracer.Thickness = 1
    tracer.Transparency = 0.7
    ESPObjects[player].tracer = tracer

    -- Health bar
    local healthBG = Drawing.new("Square")
    healthBG.Visible = false
    healthBG.Color = Color3.fromRGB(20, 20, 20)
    healthBG.Filled = true
    ESPObjects[player].healthBG = healthBG

    local healthBar = Drawing.new("Square")
    healthBar.Visible = false
    healthBar.Color = Color3.fromRGB(60, 220, 60)
    healthBar.Filled = true
    ESPObjects[player].healthBar = healthBar

    -- Skeleton (DARK RED with BLACK OUTLINE)
    local skeletonLines = {}
    local skeletonOutlines = {}
    local connections = {
        {"Head", "UpperTorso"},
        {"UpperTorso", "LowerTorso"},
        {"UpperTorso", "LeftUpperArm"},
        {"LeftUpperArm", "LeftLowerArm"},
        {"LeftLowerArm", "LeftHand"},
        {"UpperTorso", "RightUpperArm"},
        {"RightUpperArm", "RightLowerArm"},
        {"RightLowerArm", "RightHand"},
        {"LowerTorso", "LeftUpperLeg"},
        {"LeftUpperLeg", "LeftLowerLeg"},
        {"LeftLowerLeg", "LeftFoot"},
        {"LowerTorso", "RightUpperLeg"},
        {"RightUpperLeg", "RightLowerLeg"},
        {"RightLowerLeg", "RightFoot"}
    }
    
    for i = 1, #connections do
        -- Outline (black, thicker)
        local outline = Drawing.new("Line")
        outline.Visible = false
        outline.Color = Color3.fromRGB(0, 0, 0)
        outline.Thickness = 3
        table.insert(skeletonOutlines, outline)
        
        -- Main line (dark red, thinner)
        local line = Drawing.new("Line")
        line.Visible = false
        line.Color = Color3.fromRGB(139, 0, 0) -- Dark red
        line.Thickness = 1.5
        table.insert(skeletonLines, line)
    end
    ESPObjects[player].skeleton = skeletonLines
    ESPObjects[player].skeletonOutlines = skeletonOutlines
    ESPObjects[player].skeletonConnections = connections
end

