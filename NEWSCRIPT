-- Get character functions
local function GetCharacter(player)
    return player and player.Character
end

local function GetRootPart(player)
    local char = GetCharacter(player)
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function GetHumanoid(player)
    local char = GetCharacter(player)
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function IsAlive(player)
    local hum = GetHumanoid(player)
    return hum and hum.Health > 0
end

-- WorldToViewport function
local function WorldToViewport(pos)
    local camera = workspace.CurrentCamera
    local screenPos, onScreen = camera:WorldToViewportPoint(pos)
    return Vector2.new(screenPos.X, screenPos.Y), onScreen, screenPos.Z
end

-- ESP Render Loop - OPTIMIZED for FPS
local frameCounter = 0
local skeletonUpdateRate = 2 -- Update skeleton every 2nd frame

RunService.RenderStepped:Connect(function()
    if not ESPConfig.Enabled then
        for player, _ in pairs(ESPObjects) do
            RemoveESP(player)
        end
        return
    end
    
    frameCounter = frameCounter + 1
    local updateSkeleton = (frameCounter % skeletonUpdateRate == 0)
    
    -- First, clean up ESP for players who left
    for player, _ in pairs(ESPObjects) do
        local stillInGame = false
        for _, p in ipairs(Players:GetPlayers()) do
            if p == player then
                stillInGame = true
                break
            end
        end
        if not stillInGame then
            RemoveESP(player)
        end
    end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player == localPlayer then continue end

        local char = GetCharacter(player)
        local root = GetRootPart(player)
        local hum = GetHumanoid(player)

        if not char or not root or not hum or hum.Health <= 0 then
            RemoveESP(player)
            continue
        end

        if not ESPObjects[player] then
            CreateESP(player)
        end

        local dist = (root.Position - (localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") and localPlayer.Character.HumanoidRootPart.Position or Vector3.new())).Magnitude
        if dist > ESPConfig.MaxDist then
            for _, obj in pairs(ESPObjects[player]) do
                pcall(function() obj.Visible = false end)
            end
            continue
        end

        local headPos = char:FindFirstChild("Head") and char.Head.Position or root.Position + Vector3.new(0, 2, 0)
        local feetPos = root.Position - Vector3.new(0, 3, 0)

        local headScreen, onScreenH = WorldToViewport(headPos)
        local feetScreen, onScreenF = WorldToViewport(feetPos)

        local visible = onScreenH and onScreenF
        local esps = ESPObjects[player]

        -- Colors: All BLACK
        local boxColor = Color3.fromRGB(0, 0, 0)
        local tracerColor = Color3.fromRGB(0, 0, 0)

        if visible and ESPConfig.Boxes then
            local height = math.abs(headScreen.Y - feetScreen.Y)
            local width = height * 0.5
            esps.box.Visible = true
            esps.box.Color = boxColor
            esps.box.Size = Vector2.new(width, height)
            esps.box.Position = Vector2.new(headScreen.X - width / 2, headScreen.Y)

            -- Health bar
            if ESPConfig.HealthBar then
                local hp = hum.Health / hum.MaxHealth
                local barH = height
                local barW = 4
                local barX = headScreen.X - width / 2 - barW - 2
                local barY = headScreen.Y

                esps.healthBG.Visible = true
                esps.healthBG.Size = Vector2.new(barW, barH)
                esps.healthBG.Position = Vector2.new(barX, barY)

                esps.healthBar.Visible = true
                esps.healthBar.Size = Vector2.new(barW, barH * hp)
                esps.healthBar.Position = Vector2.new(barX, barY + barH * (1 - hp))
                esps.healthBar.Color = Color3.fromRGB(
                    math.floor(255 * (1 - hp)),
                    math.floor(255 * hp),
                    40
                )
            else
                esps.healthBG.Visible = false
                esps.healthBar.Visible = false
            end
        else
            esps.box.Visible = false
            esps.healthBG.Visible = false
            esps.healthBar.Visible = false
        end

        if visible and ESPConfig.Names then
            esps.nameTag.Visible = true
            esps.nameTag.Text = player.DisplayName
            esps.nameTag.Position = Vector2.new(headScreen.X, headScreen.Y - 16)
        else
            esps.nameTag.Visible = false
        end

        if visible and ESPConfig.Distance then
            esps.distTag.Visible = true
            esps.distTag.Text = string.format("[%.0fm]", dist)
            esps.distTag.Position = Vector2.new(headScreen.X, headScreen.Y - 5)
        else
            esps.distTag.Visible = false
        end

        if visible and ESPConfig.Tracers then
            local vp = workspace.CurrentCamera.ViewportSize
            esps.tracer.Visible = true
            esps.tracer.From = Vector2.new(vp.X / 2, vp.Y)
            esps.tracer.To = feetScreen
            esps.tracer.Color = tracerColor
        else
            esps.tracer.Visible = false
        end

        -- Skeleton ESP (DARK RED with BLACK OUTLINE) - Optimized with frame skipping
        if updateSkeleton and ESPConfig.Skeleton and char then
            local skeletonLines = esps.skeleton
            local skeletonOutlines = esps.skeletonOutlines
            local connections = esps.skeletonConnections
            
            if skeletonLines and skeletonOutlines and connections then
                -- Pre-check if all required parts exist before drawing
                local allPartsValid = true
                local partPositions = {}
                
                for _, connection in ipairs(connections) do
                    local part1Name, part2Name = connection[1], connection[2]
                    
                    if not partPositions[part1Name] then
                        local part = char:FindFirstChild(part1Name)
                        if part then
                            partPositions[part1Name] = part.Position
                        else
                            allPartsValid = false
                            break
                        end
                    end
                    
                    if not partPositions[part2Name] then
                        local part = char:FindFirstChild(part2Name)
                        if part then
                            partPositions[part2Name] = part.Position
                        else
                            allPartsValid = false
                            break
                        end
                    end
                end
                
                -- Only draw if all parts are valid
                if allPartsValid then
                    for i, connection in ipairs(connections) do
                        local pos1 = partPositions[connection[1]]
                        local pos2 = partPositions[connection[2]]
                        
                        local screenPos1, onScreen1 = WorldToViewport(pos1)
                        local screenPos2, onScreen2 = WorldToViewport(pos2)
                        
                        if onScreen1 and onScreen2 then
                            -- Update outline (black, behind)
                            skeletonOutlines[i].Visible = true
                            skeletonOutlines[i].From = screenPos1
                            skeletonOutlines[i].To = screenPos2
                            
                            -- Update main line (dark red, on top)
                            skeletonLines[i].Visible = true
                            skeletonLines[i].From = screenPos1
                            skeletonLines[i].To = screenPos2
                        else
                            skeletonOutlines[i].Visible = false
                            skeletonLines[i].Visible = false
                        end
                    end
                else
                    -- Hide all if parts missing
                    for i = 1, #connections do
                        skeletonOutlines[i].Visible = false
                        skeletonLines[i].Visible = false
                    end
                end
            end
        elseif not updateSkeleton then
            -- Don't hide skeleton on skipped frames, just don't update
        else
            -- Hide all skeleton lines when disabled
            if esps.skeleton then
                for _, line in ipairs(esps.skeleton) do
                    line.Visible = false
                end
            end
            if esps.skeletonOutlines then
                for _, outline in ipairs(esps.skeletonOutlines) do
                    outline.Visible = false
                end
            end
        end
    end
end)

