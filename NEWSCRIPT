local function getPlayerNames()
    local names = {"None"}
    local playerList = {}
    
    local myRoot = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
    
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= localPlayer then
            local dist = math.huge
            if myRoot and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                dist = (p.Character.HumanoidRootPart.Position - myRoot.Position).Magnitude
            end
            table.insert(playerList, {name = p.Name, distance = dist, player = p})
        end
    end
    
    table.sort(playerList, function(a, b)
        return a.distance < b.distance
    end)
    
    for _, p in ipairs(playerList) do
        table.insert(names, p.name)
    end
    
    currentPlayerList = playerList
    return names, playerList
end

