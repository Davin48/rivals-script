-- Advanced Remote Scanner
local function scanAllRemotes()
    local RS = game:GetService("ReplicatedStorage")
    local Players = game:GetService("Players")
    local localPlayer = Players.LocalPlayer
    local categories = {
        unlock = {},
        weapon = {},
        item = {},
        level = {},
        fire = {},
        other = {}
    }
    
    -- Helper function to categorize remotes
    local function categorizeRemote(obj)
        if not (obj:IsA("RemoteEvent") or obj:IsA("UnreliableRemoteEvent") or obj:IsA("RemoteFunction")) then
            return
        end
        
        local name = obj.Name:lower()
        
        -- Categorize remotes
        if name:find("unlock") or name:find("grant") or name:find("give") then
            table.insert(categories.unlock, obj)
        elseif name:find("weapon") or name:find("gun") or name:find("arm") or name:find("loadout") then
            table.insert(categories.weapon, obj)
        elseif name:find("item") or name:find("charm") or name:find("skin") or name:find("camo") or name:find("cosmetic") then
            table.insert(categories.item, obj)
        elseif name:find("level") or name:find("xp") or name:find("rank") or name:find("prestige") or name:find("tier") then
            table.insert(categories.level, obj)
        elseif name:find("fire") or name:find("shoot") or name:find("hit") or name:find("damage") then
            table.insert(categories.fire, obj)
        else
            table.insert(categories.other, obj)
        end
    end
    
    -- Scan ReplicatedStorage
    for _, obj in pairs(RS:GetDescendants()) do
        categorizeRemote(obj)
    end
    
    -- Scan PlayerScripts and Player
    if localPlayer then
        -- Scan Player object itself
        for _, obj in pairs(localPlayer:GetDescendants()) do
            categorizeRemote(obj)
        end
        
        -- Scan PlayerScripts
        local playerScripts = localPlayer:FindFirstChild("PlayerScripts")
        if playerScripts then
            for _, obj in pairs(playerScripts:GetDescendants()) do
                categorizeRemote(obj)
            end
        end
        
        -- Scan PlayerGui
        local playerGui = localPlayer:FindFirstChild("PlayerGui")
        if playerGui then
            for _, obj in pairs(playerGui:GetDescendants()) do
                categorizeRemote(obj)
            end
        end
    end
    
    -- GC Scan for hidden remotes in tables
    for _, v in pairs(getgc(true)) do
        if typeof(v) == "table" then
            for k, val in pairs(v) do
                if typeof(val) == "Instance" and (val:IsA("RemoteEvent") or val:IsA("RemoteFunction")) then
                    local name = val.Name:lower()
                    if name:find("unlock") or name:find("weapon") or name:find("item") then
                        -- Check if already in categories
                        local found = false
                        for _, cat in pairs(categories) do
                            for _, remote in pairs(cat) do
                                if remote == val then
                                    found = true
                                    break
                                end
                            end
                            if found then break end
                        end
                        if not found then
                            if name:find("unlock") then
                                table.insert(categories.unlock, val)
                            elseif name:find("weapon") then
                                table.insert(categories.weapon, val)
                            elseif name:find("item") then
                                table.insert(categories.item, val)
                            end
                        end
                    end
                end
            end
        end
    end
    
    return categories
end

