FarmSection:AddToggle("Enable AFK Farm", false, function(v)
    FarmSettings.Enabled = v
    if v then
        notify("AFK Farm", "Auto 1v1 Farm aktiviert - Settings werden automatisch gesetzt", 3)
        
        -- FORCE ENABLE SETTINGS IMMEDIATELY
        FOV.Size = 500
        FOV.Enabled = true
