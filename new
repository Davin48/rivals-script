    if isAimKey and not saIsAimKeyDown then
        saIsAimKeyDown = true
        saAutoClick()
    end
end)

UserInputService.InputEnded:Connect(function(input, isProcessed)
    if isProcessed then return end
    
    local isAimKey = false
    if selectedSilentAimKey == "RightMouseButton" and input.UserInputType == Enum.UserInputType.MouseButton2 then
        isAimKey = true
    elseif input.KeyCode.Name == selectedSilentAimKey then
        isAimKey = true
    end
    
    if isAimKey then
        saIsAimKeyDown = false
    end
end)

RunService.Heartbeat:Connect(function()
