-- Remove All Textures Feature
local texturesRemoved = false
local originalTextures = {}

local function removeAllTextures(enable)
    if enable then
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") and not v:IsA("MeshPart") then
                if v:FindFirstChildOfClass("Texture") then
                    for _, tex in pairs(v:GetChildren()) do
                        if tex:IsA("Texture") or tex:IsA("Decal") then
                            if not originalTextures[tex] then
                                originalTextures[tex] = tex.Transparency
                            end
                            tex.Transparency = 1
                        end
                    end
                end
                if v:FindFirstChildOfClass("Decal") then
                    for _, dec in pairs(v:GetChildren()) do
                        if dec:IsA("Decal") then
                            if not originalTextures[dec] then
                                originalTextures[dec] = dec.Transparency
                            end
                            dec.Transparency = 1
                        end
                    end
                end
            end
        end
        notify("Textures", "All textures removed", 2)
    else
        for tex, trans in pairs(originalTextures) do
            if tex and tex.Parent then
                pcall(function()
                    tex.Transparency = trans
                end)
            end
        end
        originalTextures = {}
        notify("Textures", "Textures restored", 2)
    end
end

MiscSection:AddToggle("Remove All Textures", false, function(v)
    texturesRemoved = v
    removeAllTextures(v)
end)

