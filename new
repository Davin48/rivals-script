                        if #args >= 1 then
                            if typeof(args[1]) == "CFrame" then
                                args[1] = CFrame.new(args[1].Position, target.Position)
                            elseif typeof(args[1]) == "Vector3" then
                                args[1] = target.Position
                            end
                        end
                        
                        -- Add headshot multiplier
                        if #args >= 3 and typeof(args[3]) == "number" then
                            args[3] = args[3] * UltraMagicBullet.DamageBoost
                        end
                        
                        return originalFunctions[FireRemote](self, unpack(args))
                    end
                end
                return originalFunctions[FireRemote](self, ...)
            end
        end
    else
