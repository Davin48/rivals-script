local function premiumUnlockAll()
    local categories = scanAllRemotes()
    local totalCalls = 0
    local successCount = 0
    local RS = game:GetService("ReplicatedStorage")
    local Players = game:GetService("Players")
    local localPlayer = Players.LocalPlayer
    
    notify("Unlock All", "ANTI-DETECTION MODE - Langsamer & Sicher...", 3)
    
    -- Nur die wichtigsten Argument-Muster
    local safeArgs = {
        {"all"},
        {true},
        {localPlayer.UserId},
    }
    
    -- Nur unlock und weapon Remotes (nicht alle)
    local targetRemotes = {}
    for _, remote in pairs(categories.unlock) do
        table.insert(targetRemotes, remote)
    end
    for _, remote in pairs(categories.weapon) do
        table.insert(targetRemotes, remote)
    end
    for _, remote in pairs(categories.item) do
        table.insert(targetRemotes, remote)
    end
    
    notify("Unlock All", "Ziele: " .. #targetRemotes .. " Remotes", 2)
    
    -- Langsame Ausführung mit Rate Limiting
    for i, remote in pairs(targetRemotes) do
        local name = remote.Name:lower()
        
        -- Nur alle 5 Remotes eine Pause
        if i % 5 == 0 then
            task.wait(0.5) -- Längere Pause alle 5 Remotes
        end
        
        -- Nur 3 Argumente pro Remote (nicht 30+)
        for _, args in pairs(safeArgs) do
            local success = pcall(function()
                if remote:IsA("RemoteFunction") then
                    remote:InvokeServer(unpack(args))
                else
                    remote:FireServer(unpack(args))
                end
            end)
            if success then
                successCount = successCount + 1
            end
            totalCalls = totalCalls + 1
            task.wait(0.1) -- Pause zwischen Aufrufen
        end
    end
    
    notify("Unlock All", "Fertig! " .. successCount .. "/" .. totalCalls .. " erfolgreich", 3)
end

