-- Utility Functions
local function createDrawing(type, props)
    local d = Drawing.new(type)
    for k, v in pairs(props or {}) do
        d[k] = v
    end
    return d
end

local function worldToScreen(pos)
    local screen, visible = camera:WorldToViewportPoint(pos)
    return Vector2.new(screen.X, screen.Y), visible and screen.Z > 0
end

local function getDistance(pos)
    return (pos - camera.CFrame.Position).Magnitude
end

local function isPlayerVisible(player)
    if not player.Character then return false end
    local root = player.Character:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    
    local ray = Ray.new(camera.CFrame.Position, (root.Position - camera.CFrame.Position).Unit * (root.Position - camera.CFrame.Position).Magnitude)
    local hit = workspace:FindPartOnRayWithIgnoreList(ray, {localPlayer.Character, player.Character})
    return not (hit and hit:IsA("BasePart"))
end

-- ESP Object Creation
local function createPlayerESP(player)
    if player == localPlayer then return end
    if playerCache[player] then return end
    
    local esp = {
        box = createDrawing("Square", {
            Thickness = 1,
            Filled = false,
            Visible = false,
            ZIndex = 1
        }),
        boxFill = createDrawing("Square", {
            Thickness = 1,
            Filled = true,
            Visible = false,
            Transparency = ESP.BoxFillTransparency,
            ZIndex = 0
        }),
        name = createDrawing("Text", {
            Text = player.Name,
            Size = 13,
            Center = true,
            Outline = true,
            Visible = false,
            ZIndex = 2
        }),
        healthBar = createDrawing("Line", {
            Thickness = 2,
            Visible = false,
            ZIndex = 3
        }),
        healthBarBg = createDrawing("Line", {
            Thickness = 4,
            Visible = false,
            ZIndex = 2
        }),
        distance = createDrawing("Text", {
            Size = 11,
            Center = true,
            Outline = true,
            Visible = false,
            ZIndex = 2
        }),
        tracer = createDrawing("Line", {
            Thickness = 1,
            Visible = false,
            ZIndex = 1
        }),
        skeleton = {},
    }
    
    -- Create skeleton lines (6 lines for R6/R15 compatibility)
    for i = 1, 6 do
        esp.skeleton[i] = createDrawing("Line", {
            Thickness = 1.5,
            Visible = false,
            ZIndex = 1
        })
    end
    
    playerCache[player] = esp
end

local function removePlayerESP(player)
    local esp = playerCache[player]
    if not esp then return end
    
    for _, obj in pairs(esp) do
        if type(obj) == "table" then
            for _, line in pairs(obj) do
                if line and line.Remove then line:Remove() end
            end
        elseif obj and obj.Remove then
            obj:Remove()
        end
    end
    
    playerCache[player] = nil
end

-- Update ESP
local function updateESP()
    if not ESP.Enabled then
        for _, esp in pairs(playerCache) do
            for key, obj in pairs(esp) do
                if key == "skeleton" then
                    for _, line in pairs(obj) do
                        line.Visible = false
                    end
                elseif obj.Visible ~= nil then
                    obj.Visible = false
                end
            end
        end
        return
    end
    
    for player, esp in pairs(playerCache) do
        local character = player.Character
        if not character then
            for key, obj in pairs(esp) do
                if key == "skeleton" then
                    for _, line in pairs(obj) do line.Visible = false end
                elseif obj.Visible ~= nil then
                    obj.Visible = false
                end
            end
            continue
        end
        
        local root = character:FindFirstChild("HumanoidRootPart")
        local head = character:FindFirstChild("Head")
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        
        if not root or not head or not humanoid then
            for key, obj in pairs(esp) do
                if key == "skeleton" then
                    for _, line in pairs(obj) do line.Visible = false end
                elseif obj.Visible ~= nil then
                    obj.Visible = false
                end
            end
            continue
        end
        
        -- Extra validation to prevent empty boxes
        if not root or not head or not humanoid then
            for key, obj in pairs(esp) do
                if key == "skeleton" then
                    for _, line in pairs(obj) do line.Visible = false end
                elseif obj.Visible ~= nil then
                    obj.Visible = false
                end
            end
            continue
        end
        
        -- Validate character has required parts (prevents empty boxes)
        local hasValidParts = false
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") and part.Size.Magnitude > 0 then
                hasValidParts = true
                break
            end
        end
        
        if not hasValidParts then
            for key, obj in pairs(esp) do
                if key == "skeleton" then
                    for _, line in pairs(obj) do line.Visible = false end
                elseif obj.Visible ~= nil then
                    obj.Visible = false
                end
            end
            continue
        end
        
        -- Check if player is dead (gelaved fix)
        if humanoid and humanoid.Health <= 0 then
            for key, obj in pairs(esp) do
                if key == "skeleton" then
                    for _, line in pairs(obj) do line.Visible = false end
                elseif obj.Visible ~= nil then
                    obj.Visible = false
                end
            end
            continue
        end
        
        -- Check distance
        local dist = getDistance(root.Position)
        if dist > ESP.MaxDistance then
            for key, obj in pairs(esp) do
                if key == "skeleton" then
                    for _, line in pairs(obj) do line.Visible = false end
                elseif obj.Visible ~= nil then
                    obj.Visible = false
                end
            end
            continue
        end
        
        -- Wall check
        if ESP.WallCheck and not isPlayerVisible(player) then
            for key, obj in pairs(esp) do
                if key == "skeleton" then
                    for _, line in pairs(obj) do line.Visible = false end
                elseif obj.Visible ~= nil then
                    obj.Visible = false
                end
            end
            continue
        end
        
        -- Get screen positions
        local rootPos, rootVisible = worldToScreen(root.Position)
        local headPos, headVisible = worldToScreen(head.Position)
        
        if not rootVisible or not headVisible then
            for key, obj in pairs(esp) do
                if key == "skeleton" then
                    for _, line in pairs(obj) do line.Visible = false end
                elseif obj.Visible ~= nil then
                    obj.Visible = false
                end
            end
            continue
        end
        
        -- Calculate box dimensions (larger for better visibility)
        local height = math.abs(rootPos.Y - headPos.Y) * 2.8
        local width = height * 0.75
        local boxPos = Vector2.new(rootPos.X - width/2, rootPos.Y - height/2.2)
        
        -- Box ESP
        if ESP.Box then
            esp.box.Size = Vector2.new(width, height)
            esp.box.Position = boxPos
            esp.box.Color = ESP.BoxColor
            esp.box.Visible = true
            
            if ESP.BoxFilled then
                esp.boxFill.Size = Vector2.new(width, height)
                esp.boxFill.Position = boxPos
                esp.boxFill.Color = ESP.BoxFillColor
                esp.boxFill.Transparency = ESP.BoxFillTransparency
                esp.boxFill.Visible = true
            else
                esp.boxFill.Visible = false
            end
        else
            esp.box.Visible = false
            esp.boxFill.Visible = false
        end
        
        -- Name ESP
        if ESP.Name then
            esp.name.Position = Vector2.new(rootPos.X, boxPos.Y - 20)
            esp.name.Color = ESP.NameColor
            esp.name.Visible = true
        else
            esp.name.Visible = false
        end
        
        -- Health ESP
        if ESP.Health and humanoid then
            local healthPercent = humanoid.Health / humanoid.MaxHealth
            local barHeight = height * 0.8
            local barPos = Vector2.new(boxPos.X - 8, boxPos.Y + height/2)
            
            esp.healthBarBg.From = barPos
            esp.healthBarBg.To = Vector2.new(barPos.X, barPos.Y - barHeight)
            esp.healthBarBg.Color = Color3.fromRGB(0, 0, 0)
            esp.healthBarBg.Visible = true
            
            esp.healthBar.From = barPos
            esp.healthBar.To = Vector2.new(barPos.X, barPos.Y - barHeight * healthPercent)
            esp.healthBar.Color = Color3.fromRGB(0, 255, 0):Lerp(Color3.fromRGB(255, 0, 0), 1 - healthPercent)
            esp.healthBar.Visible = true
        else
            esp.healthBar.Visible = false
            esp.healthBarBg.Visible = false
        end
        
        -- Distance ESP
        if ESP.Distance then
            esp.distance.Text = string.format("%.0f studs", dist)
            esp.distance.Position = Vector2.new(rootPos.X, boxPos.Y + height + 5)
            esp.distance.Visible = true
        else
            esp.distance.Visible = false
        end
        
        -- Tracer ESP
        if ESP.Tracer then
            esp.tracer.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
            esp.tracer.To = rootPos
            esp.tracer.Color = ESP.TracerColor
            esp.tracer.Visible = true
        else
            esp.tracer.Visible = false
        end
        
        -- Skeleton ESP (R6/R15 compatible)
        if ESP.Skeleton then
            local parts = {
                head = head,
                torso = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso"),
                leftArm = character:FindFirstChild("Left Arm") or character:FindFirstChild("LeftUpperArm"),
                rightArm = character:FindFirstChild("Right Arm") or character:FindFirstChild("RightUpperArm"),
                leftLeg = character:FindFirstChild("Left Leg") or character:FindFirstChild("LeftUpperLeg"),
                rightLeg = character:FindFirstChild("Right Leg") or character:FindFirstChild("RightUpperLeg"),
            }
            
            local function getPartPos(part)
                if not part then return nil end
                local pos, vis = worldToScreen(part.Position)
                if not vis then return nil end
                return pos
            end
            
            local positions = {
                getPartPos(parts.head),
                getPartPos(parts.torso),
                getPartPos(parts.leftArm),
                getPartPos(parts.rightArm),
                getPartPos(parts.leftLeg),
                getPartPos(parts.rightLeg),
            }
            
            local connections = {
                {1, 2}, -- Head to Torso
                {2, 3}, -- Torso to Left Arm
                {2, 4}, -- Torso to Right Arm
                {2, 5}, -- Torso to Left Leg
                {2, 6}, -- Torso to Right Leg
            }
            
            for i, connection in ipairs(connections) do
                local from, to = positions[connection[1]], positions[connection[2]]
                if from and to then
                    esp.skeleton[i].From = from
                    esp.skeleton[i].To = to
                    esp.skeleton[i].Color = ESP.SkeletonColor
                    esp.skeleton[i].Visible = true
                else
                    esp.skeleton[i].Visible = false
                end
            end
        else
            for _, line in pairs(esp.skeleton) do
                line.Visible = false
            end
        end
    end
end

