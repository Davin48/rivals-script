                    silentAimEnabled = true
                    selectedSilentAimKey = "RightMouseButton" -- Ensure right mouse is the aim key
                    saIsAimKeyDown = true -- Tell silent aim system that aim key is held
                    saAutoClick() -- Start auto-clicking
                    notify("AFK Farm", "FOV 500 + Silent Aim READY!", 2)
                    
                    -- Press K to close menu ONCE per session
                    if not FarmSettings.MenuClosed then
                        FarmSettings.MenuClosed = true
                        task.delay(1, function()
                            pcall(function()
                                VIM:SendKeyEvent(true, Enum.KeyCode.K, false, game)
                                task.wait(0.1)
                                VIM:SendKeyEvent(false, Enum.KeyCode.K, false, game)
                            end)
                            notify("AFK Farm", "Menu geschlossen (K)", 1)
                        end)
                    end
                    
                    -- Circle TP + Hold Right Mouse + Continuous Mouse Down loop
                    spawn(function()
                        local angle = 0
                        
                        -- Start continuous mouse down movement in separate thread
                        local mouseDownActive = true
                        spawn(function()
                            while mouseDownActive and combatActive and FarmSettings.Enabled do
                                -- Multiple methods to ensure mouse stays looking down
                                pcall(function()
                                    -- Method 1: mousemoverel
                                    if mousemoverel then
                                        mousemoverel(0, 100)
                                    end
                                end)
                                
                                pcall(function()
                                    -- Method 2: Absolute mouse move to bottom center
                                    local screenX = camera.ViewportSize.X / 2
                                    local screenY = camera.ViewportSize.Y - 50
                                    VIM:SendMouseMoveEvent(screenX, screenY, game)
                                end)
                                
                                task.wait(0.05) -- Very fast repetition
                            end
                        end)
                        
                        while combatActive and FarmSettings.Enabled do
                            -- Check both still alive
                            local myChar = localPlayer.Character
                            local myHumanoid = myChar and myChar:FindFirstChild("Humanoid")
                            local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                            local targetChar = target and target.Character
                            local targetHumanoid = targetChar and targetChar:FindFirstChild("Humanoid")
                            local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
                            local targetHead = targetChar and targetChar:FindFirstChild("Head")
                            
                            if not myHumanoid or myHumanoid.Health <= 0 or not myRoot then
                                break
                            end
                            if not targetHumanoid or targetHumanoid.Health <= 0 or not targetRoot then
                                break
                            end
                            
                            -- Circle TP above enemy (radius 3, height 12 - stable)
                            angle = angle + 0.05 -- Slower rotation
                            local x = math.cos(angle) * 3
                            local z = math.sin(angle) * 3
                            local circlePos = targetRoot.Position + Vector3.new(x, 12, z)
                            
                            -- Look DIRECTLY DOWN at enemy (steep angle)
                            local lookTarget = targetHead and targetHead.Position or targetRoot.Position
                            myRoot.CFrame = CFrame.new(circlePos, lookTarget)
                            
                            -- Force camera to look DOWN at enemy
                            local camPos = camera.CFrame.Position
                            local lookDownPos = Vector3.new(lookTarget.X, lookTarget.Y - 10, lookTarget.Z)
                            camera.CFrame = CFrame.new(camPos, lookDownPos)
                            
                            -- Hold RIGHT mouse button (for Silent Aim)
                            VIM:SendMouseButtonEvent(camera.ViewportSize.X/2, camera.ViewportSize.Y/2, 1, true, game, 1)
                            
                            RunService.RenderStepped:Wait()
                        end
                        
                        -- Stop mouse down thread
                        mouseDownActive = false
                        
                        -- Release right mouse button when combat ends
                        VIM:SendMouseButtonEvent(camera.ViewportSize.X/2, camera.ViewportSize.Y/2, 1, false, game, 1)
                        saIsAimKeyDown = false
                        if saAutoClickConnection then
                            saAutoClickConnection:Disconnect()
                            saAutoClickConnection = nil
                        end
                    end)
                    
                    -- Wait for round to end (someone dies)
                    while FarmSettings.Enabled and combatActive do
                        local myChar = localPlayer.Character
                        local myHumanoid = myChar and myChar:FindFirstChild("Humanoid")
                        local targetChar = target and target.Character
                        local targetHumanoid = targetChar and targetChar:FindFirstChild("Humanoid")
                        
                        -- If we die
                        if not myHumanoid or myHumanoid.Health <= 0 then
                            combatActive = false
                            notify("AFK Farm", "Gestorben - warte auf Respawn...", 2)
                            break
                        end
                        
                        -- If enemy dies
                        if not targetHumanoid or targetHumanoid.Health <= 0 then
                            combatActive = false
                            notify("AFK Farm", "Gegner eliminiert! - Win!", 2)
                            -- Auto search for new round
                            FarmSettings.IsInGame = false
                            break
                        end
                        
                        wait(0.2)
                    end
                    
                    -- Wait before looking for new enemy
                    wait(3)
                end
            end
            wait(0.5)
        end
    end)
end

