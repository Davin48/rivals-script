-- UNLOCK ALL - Activate First!
-- ═══════════════════════════════════════════════
local function ApplyUnlockAll()
    pcall(function()
        for _, obj in pairs(getgc(true)) do
            if typeof(obj) == "table" then
                if rawget(obj, "OwnsCosmetic") then
                    obj.OwnsCosmetic = function() return true end
                end
                if rawget(obj, "GetOwnedCosmetics") then
                    obj.GetOwnedCosmetics = function() return {} end
                end
            end
        end
    end)
    print("[+] Unlock All activated - all skins unlocked!")
end

-- Apply immediately and retry after delay
ApplyUnlockAll()
