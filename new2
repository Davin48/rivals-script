-- No Reload (Infinite Ammo) Variables
local noReloadEnabled = false
local noReloadConnection = nil

Tab3:CreateToggle({
    Name = "No Reload (Infinite Ammo)",
    CurrentValue = false,
    Flag = "NoReloadToggle",
    Callback = function(Value)
        noReloadEnabled = Value
        if Value then
            -- Hook into gun ammo system
            noReloadConnection = RunService.Heartbeat:Connect(function()
                if not noReloadEnabled then return end
                
                local character = localPlayer.Character
                if not character then return end
                
                local tool = character:FindFirstChildOfClass("Tool")
                if not tool then return end
                
                -- Check if tool is a gun
                local isGun = tool:FindFirstChild("Ammo") or 
                              tool:FindFirstChild("MaxAmmo") or
                              tool:GetAttribute("Ammo") or
                              tool:FindFirstChild("GunScript") or
                              tool:FindFirstChild("FireEvent")
                
                if isGun then
                    -- Try to set ammo values directly
                    pcall(function()
                        local ammo = tool:FindFirstChild("Ammo")
                        local maxAmmo = tool:FindFirstChild("MaxAmmo")
                        
                        if ammo and maxAmmo then
                            -- Keep ammo at max
                            if ammo:IsA("IntValue") or ammo:IsA("NumberValue") then
                                if ammo.Value < maxAmmo.Value then
                                    ammo.Value = maxAmmo.Value
                                end
                            end
                        end
                        
                        -- Also try attribute-based ammo
                        if tool:GetAttribute("Ammo") and tool:GetAttribute("MaxAmmo") then
                            if tool:GetAttribute("Ammo") < tool:GetAttribute("MaxAmmo") then
                                tool:SetAttribute("Ammo", tool:GetAttribute("MaxAmmo"))
                            end
                        end
                    end)
                end
            end)
            
            airwaveUI:Notify({
                Title = "No Reload",
                Content = "Infinite Ammo enabled",
                Duration = 2
            })
        else
            if noReloadConnection then
                noReloadConnection:Disconnect()
                noReloadConnection = nil
            end
        end
    end,
})

